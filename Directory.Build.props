<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>Daniel Grimes</Authors>
    <Company>DBHQ Consulting Ltd</Company>
    <Copyright>Copyright (c) 2026 DBHQ Consulting Ltd</Copyright>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or '$(MSBuildProjectName)' == 'Gannet.TestSupport'">
    <IsPackable>false</IsPackable>
    <!-- Test names use underscores; CA1707 would reject them. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1861</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- Library code awaits without ConfigureAwait in an ASP.NET Core and console app; no sync context to capture. -->
    <NoWarn>$(NoWarn);CA2007;CA1515</NoWarn>
  </PropertyGroup>
</Project>
