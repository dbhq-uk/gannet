---
import { REPO, UPSTREAM, nav, site } from "../lib/site";
const year = 2026;
---

{/* The footer is navy, the reference's full-bleed brand band, and it is where
    the publisher signs the page: the DBHQ lockup and the "Also from DBHQ"
    block live here, not in the masthead.

    The page list is rendered from `nav`, which is why adding a page to that
    list is all it takes for every page to link it. tests/content.test.mjs
    asserts no page is a dead end, and this block is what holds it. */}
<footer class="footer band-ink">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/logo/lockup-white.svg" alt="gannet" width="144" height="36" />
      <p>gannet is free and open source, published by DBHQ. It is in development and not released yet.</p>
    </div>

    <nav class="footer-links" aria-label="All pages">
      <a href="/">Home</a>
      {nav.map((n) => <a href={n.path}>{n.label}</a>)}
      <a href={REPO}>Source on GitHub<span class="out-glyph" aria-hidden="true">&#8599;</span><span class="sr-only"> (external site)</span></a>
    </nav>
  </div>

  {/* "Also from DBHQ" - the sibling block every DBHQ subdomain carries. One-way
      here (Dan, 21 Oct 2026): the other sites' footers do not list gannet. */}
  <div class="container">
    <div class="also">
      <a class="also-dbhq" href="https://dbhq.uk/" aria-label="DBHQ">
        <img src="/logo/dbhq-lockup-horizontal-white.svg" alt="DBHQ" width="144" height="36" />
      </a>
      <p class="also-label" id="footer-also-label">Also from DBHQ</p>
      <ul class="also-list" role="list" aria-labelledby="footer-also-label">
        {site.also.map((a) => (
          <li>
            <a href={a.href}>{a.label}<span class="out-glyph" aria-hidden="true">&#8599;</span><span class="sr-only"> (external site)</span></a> - {a.desc}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container footer-base">
    <p class="footer-legal">
      gannet is MIT licensed. It is a rewrite of <a class="lnk" href={UPSTREAM}>deep-research-agent<span class="out-glyph" aria-hidden="true">&#8599;</span><span class="sr-only"> (external site)</span></a> by Tarun Sai Goddu, also MIT licensed. The photographs on this site are generated illustrations.<br />
      &copy; {year} DBHQ Consulting Ltd. Registered in England and Wales, company no. 06839674. <span class="nowrap">VAT GB 947 3073 10.</span>
    </p>
    {/* Reopens the analytics notice. Ships hidden; /consent.js reveals it. */}
    <button type="button" class="footer-settings" data-analytics-settings hidden>Cookie settings</button>
  </div>
</footer>

<style>
  .footer { padding-block: 64px 32px; }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; align-items: start; }
  .footer-brand { display: flex; flex-direction: column; gap: 14px; max-width: 36ch; }
  .footer-brand img { height: 36px; width: auto; }
  .footer-brand p { font-size: .95rem; }
  .footer-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 40px; }
  @media (max-width: 560px) { .footer-links { grid-template-columns: 1fr; } }
  .footer-links a { color: var(--ink-text); font-size: .95rem; transition: color .2s linear; }
  .footer-links a:hover { color: var(--surface); }

  .also { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--ink-line); display: grid; gap: 12px; }
  .also-dbhq img { height: 30px; width: auto; }
  .also-label { font-size: .85rem; font-weight: 500; color: color-mix(in srgb, var(--ink-text) 74%, var(--ink)); }
  .also-list { list-style: none; padding: 0; display: grid; gap: 6px; font-size: .9rem; color: color-mix(in srgb, var(--ink-text) 80%, var(--ink)); }
  .also-list a { color: var(--ink-text); font-weight: 500; }
  .also-list a:hover { color: var(--surface); }

  .footer-base { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--ink-line); }
  .footer-legal { font-size: .82rem; line-height: 1.7; color: color-mix(in srgb, var(--ink-text) 80%, var(--ink)); max-width: 86ch; }
  .footer-legal .lnk { color: var(--ink-text); }
  .footer-legal .lnk:hover { color: var(--surface); }
  .footer-settings {
    margin-top: 10px; padding: 3px 0; border: 0; background: none; cursor: pointer;
    font-family: inherit; font-size: .82rem; font-weight: 500; color: var(--ink-text);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .footer-settings[hidden] { display: none; }
  .footer-settings:hover { color: var(--surface); }
  .footer-settings:focus-visible { outline: 2px solid var(--ink-text); outline-offset: 2px; }
  .nowrap { white-space: nowrap; }
</style>
