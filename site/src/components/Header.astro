---
// A header, not a navigation system: the lockup, the four guides and the way
// out to the source. No dropdown and no burger; under 900px the guides become
// a second row that scrolls sideways.
//
// PARCHMENT WITH A BLUR, as the reference's header: it sits over the hero
// photograph on the home page and over parchment everywhere else, and the 1px
// hairline under it is what separates it from the page once a reader scrolls.
//
// The DBHQ lockup is not up here, as on terraken.dbhq.uk (Dan, 16 Sep 2026,
// for that site): on a product site the product is the thing in the corner, and
// the footer carries the publisher.
import { nav, REPO } from "../lib/site";

const path = Astro.url.pathname;
const onIndex = path === "/" || path === "";
---

<header class="hd">
  <div class="container hd-inner">
    {onIndex ? (
      <span class="hd-site" aria-current="page"><img src="/logo/lockup.svg" alt="Gannet" width="128" height="32" /></span>
    ) : (
      <a class="hd-site" href="/"><img src="/logo/lockup.svg" alt="Gannet" width="128" height="32" /></a>
    )}
    <nav class="hd-nav" aria-label="Guides">
      {nav.map((n) => (
        <a class="hd-link" href={n.path} aria-current={path === n.path ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>
    <a class="hd-gh" href={REPO} aria-label="Gannet source on GitHub">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
      </svg>
      <span class="hd-gh-label">GitHub</span>
    </a>
  </div>
</header>

<style>
  .hd {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .hd-inner { display: flex; align-items: center; gap: 28px; min-height: 64px; }
  .hd-site { display: inline-flex; flex: none; }
  .hd-site img { height: 32px; width: auto; }
  .hd-nav { display: flex; gap: 4px; margin-left: auto; }
  .hd-link {
    padding: 8px 12px; border-radius: var(--r-sm);
    color: var(--text-2); font-size: .95rem; font-weight: 500; white-space: nowrap;
    transition: color .2s var(--ease-out), background .2s var(--ease-out);
  }
  .hd-link:hover { color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); }
  .hd-link[aria-current="page"] { color: var(--text); background: color-mix(in srgb, var(--text) 8%, transparent); }
  .hd-gh {
    display: inline-flex; align-items: center; gap: 8px; flex: none;
    min-height: 40px; padding: 0 14px; border: 1px solid var(--border-2); border-radius: 999px;
    color: var(--text); font-size: .95rem; font-weight: 500;
    transition: border-color .2s var(--ease-out);
  }
  .hd-gh:hover { border-color: var(--text); }

  @media (max-width: 900px) {
    .hd-inner { flex-wrap: wrap; gap: 0 16px; padding-top: 10px; }
    .hd-gh { margin-left: auto; }
    .hd-nav {
      order: 3; width: 100%; margin: 6px 0 0; padding-bottom: 8px;
      overflow-x: auto; scrollbar-width: none;
    }
    .hd-nav::-webkit-scrollbar { display: none; }
    .hd-link { padding: 6px 10px; font-size: .9rem; }
  }
  @media (max-width: 420px) { .hd-gh-label { display: none; } .hd-gh { padding: 0 10px; } }
</style>
